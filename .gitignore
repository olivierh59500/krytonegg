# Local build products and temporary development caches.
/bin/
/.cache/
/dist/
/captures/
*.log
.DS_Store

# Python extraction caches are not source assets.
__pycache__/
*.pyc

# Android build output and machine-specific SDK locations.
/android/.gradle/
/android/build/
/android/app/build/
/android/app/libs/*.aar
/android/local.properties
